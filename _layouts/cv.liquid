---
layout: default
---

<div class="post">
  <style>
    .cv ul.list-group,
    .cv ul.items {
      list-style: none;
    }

    .cv .list-group-item,
    .cv ul.items > li {
      list-style: none;
    }

    .cv .list-group-flush > .list-group-item {
      border-top: 0;
      border-bottom: 0;
    }
  </style>

  <header class="post-header">
    <h1 class="post-title">
      {{ page.display_title | default: page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% assign cv = site.data.cv.cv %}

      <div class="card mt-3 p-3">
        <h3 class="card-title font-weight-medium">Contact Information</h3>
        <table class="table table-cv table-sm table-borderless">
          {% if cv.name %}
            <tr>
              <td class="p-1 pr-2 font-weight-bold"><b>Name</b></td>
              <td class="p-1 pl-2 font-weight-light">{{ cv.name }}</td>
            </tr>
          {% endif %}
          {% if cv.label %}
            <tr>
              <td class="p-1 pr-2 font-weight-bold"><b>Professional Title</b></td>
              <td class="p-1 pl-2 font-weight-light">{{ cv.label }}</td>
            </tr>
          {% endif %}
          {% if cv.affiliation %}
            <tr>
              <td class="p-1 pr-2 font-weight-bold"><b>Affiliation</b></td>
              <td class="p-1 pl-2 font-weight-light">{{ cv.affiliation }}</td>
            </tr>
          {% endif %}
          {% if cv.email %}
            <tr>
              <td class="p-1 pr-2 font-weight-bold"><b>Email</b></td>
              <td class="p-1 pl-2 font-weight-light"><a href="mailto:{{ cv.email }}">{{ cv.email }}</a></td>
            </tr>
          {% endif %}
          {% if cv.location %}
            <tr>
              <td class="p-1 pr-2 font-weight-bold"><b>Location</b></td>
              <td class="p-1 pl-2 font-weight-light">{{ cv.location }}</td>
            </tr>
          {% endif %}
        </table>
      </div>

      {% assign cv_summary = cv.summary | default: '' | strip %}
      {% if cv_summary != '' %}
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Professional Summary</h3>
          <p>{{ cv_summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        </div>
      {% endif %}

      {% assign empty_array = '' | split: ',' %}
      {% assign exp = cv.sections.Experience | default: empty_array %}
      {% assign vol = cv.sections.Volunteer | default: empty_array %}
      {% assign combined_experience = exp | concat: vol | al_cv_sort_by_date %}
      {% if combined_experience.size > 0 %}
        <a class="anchor" id="experience"></a>
        <div class="card mt-3 p-3 cv-appointments">
          <h3 class="card-title font-weight-medium mb-2">Academic Appointments</h3>
          <style>
            .cv-appointments .list-group-item > .row,
            .cv-education .list-group-item > .row,
            .cv-awards .list-group-item > .row,
            .cv-invited-talks .list-group-item > .row {
              align-items: flex-start;
            }

            .cv-appointments .date-column .table-cv,
            .cv-education .date-column .table-cv,
            .cv-awards .text-center .table-cv,
            .cv-invited-talks .text-center .table-cv {
              left: 50%;
              margin-top: 0.22rem;
              position: relative;
              transform: translateX(-50%);
            }

            .cv-appointments .date-column .table-cv,
            .cv-appointments .date-column .table-cv tr,
            .cv-appointments .date-column .table-cv td,
            .cv-education .date-column .table-cv,
            .cv-education .date-column .table-cv tr,
            .cv-education .date-column .table-cv td,
            .cv-awards .text-center .table-cv,
            .cv-awards .text-center .table-cv tr,
            .cv-awards .text-center .table-cv td,
            .cv-invited-talks .text-center .table-cv,
            .cv-invited-talks .text-center .table-cv tr,
            .cv-invited-talks .text-center .table-cv td {
              border: 0 !important;
            }

            .cv-appointments .date-column .badge,
            .cv-education .date-column .badge,
            .cv-awards .badge,
            .cv-invited-talks .badge {
              font-size: 0.82rem;
              text-transform: none !important;
              text-align: center;
              white-space: nowrap;
            }

            .cv-appointments p.location,
            .cv-education p.location {
              font-size: 0.78rem;
              text-align: center;
            }

            .cv-appointments h6[style*='font-style: italic'],
            .cv-education h6[style*='font-style: italic'] {
              margin-top: -0.25rem;
              margin-bottom: 0;
              line-height: 1.25;
            }

            .cv-appointments .list-group-item,
            .cv-education .list-group-item,
            .cv-awards .list-group-item,
            .cv-invited-talks .list-group-item {
              padding-top: 0.5rem;
              padding-bottom: 0.5rem;
            }

            .cv-service .service-item + .service-item {
              margin-top: 0.85rem;
            }

            .cv-service .service-label {
              font-weight: 600;
              margin-bottom: 0.18rem;
            }

            .cv-service .service-details {
              font-weight: 300;
            }
          </style>
          <div>
            {% assign entries = combined_experience %}
            {% include cv/experience.liquid %}
          </div>
        </div>
      {% endif %}

      {% for section_pair in cv.sections %}
        {% assign section_title = section_pair[0] %}
        {% assign section_entries = section_pair[1] %}

        {% if section_title == 'Experience' or section_title == 'Volunteer' %}
          {% continue %}
        {% endif %}

        <a class="anchor" id="{{ section_title | slugify }}"></a>
        <div class="card mt-3 p-3{% if section_title == 'Education' %} cv-education{% elsif section_title == 'Awards' or section_title == 'Honors and Awards' %} cv-awards{% elsif section_title == 'Invited Talks' %} cv-invited-talks{% elsif section_title == 'Professional Service' %} cv-service{% endif %}">
          <h3 class="card-title font-weight-medium{% if section_title == 'Education' or section_title == 'Awards' or section_title == 'Honors and Awards' or section_title == 'Invited Talks' %} mb-2{% endif %}">
            {{- section_title -}}
          </h3>
          <div>
            {% if section_title == 'Education' %}
              {% assign entries = section_entries | al_cv_sort_by_date %}
              {% include cv/education.liquid %}
            {% elsif section_title == 'Awards' or section_title == 'Honors and Awards' %}
              {% assign entries = section_entries %}
              {% include cv/awards.liquid %}
            {% elsif section_title == 'Invited Talks' %}
              {% assign entries = section_entries %}
              {% include cv/awards.liquid %}
            {% elsif section_title == 'Publications' %}
              {% assign entries = section_entries %}
              {% include cv/publications.liquid %}
            {% elsif section_title == 'Skills' %}
              {% assign entries = section_entries %}
              {% include cv/skills.liquid %}
            {% elsif section_title == 'Languages' %}
              {% assign entries = section_entries %}
              {% include cv/languages.liquid %}
            {% elsif section_title == 'Interests' or section_title == 'Academic Interests' %}
              {% assign entries = section_entries %}
              {% include cv/interests.liquid %}
            {% elsif section_title == 'Certificates' %}
              {% assign entries = section_entries %}
              {% include cv/certificates.liquid %}
            {% elsif section_title == 'Projects' or section_title == 'Open Source Projects' %}
              {% assign entries = section_entries | al_cv_sort_by_date %}
              {% include cv/projects.liquid %}
            {% elsif section_title == 'References' %}
              {% assign entries = section_entries %}
              {% include cv/references.liquid %}
            {% elsif section_title == 'Professional Service' %}
              <div class="card-text">
                {% for entry in section_entries %}
                  <div class="service-item">
                    <div class="service-label">{{ entry.label }}</div>
                    <div class="service-details">{{ entry.details }}</div>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              {% for entry in section_entries %}
                {% if entry.bullet %}
                  <ul class="card-text font-weight-light list-group list-group-flush">
                    <li class="list-group-item">{{ entry.bullet | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                  </ul>
                {% elsif entry.label %}
                  <div class="card-text font-weight-light">
                    <strong>{{ entry.label }}:</strong> {{ entry.details }}
                  </div>
                {% endif %}
              {% endfor %}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>
